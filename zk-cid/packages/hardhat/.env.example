# Template for Hardhat environment variables.

# To use this template, copy this file, rename it .env, and fill in the values.

# API keys are NOT shipped with this repo — hardhat.config.ts reads them
# exclusively from the environment. Local development (Anvil/Hardhat) works
# without keys; you only need them for testnet RPC / mainnet forking / verification.

# To access the values stored in this .env file you can use: process.env.VARIABLENAME

# Alchemy API key for Sepolia/mainnet RPC and mainnet forking. Get yours at https://dashboard.alchemyapi.io
ALCHEMY_API_KEY=

# Etherscan API key for `yarn verify` contract verification.
ETHERSCAN_API_KEY=

# Don't fill this value manually, run yarn generate to generate a new account or yarn account:import to import an existing PK.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Required when deploying ComplianceGateReceiver: pin the adapter to the exact CRE workflow
# that is allowed to request credential revocations. Both values must be non-empty.
# EXPECTED_WORKFLOW_AUTHOR=0x...
# EXPECTED_WORKFLOW_ID=0x...
# Optional; requires EXPECTED_WORKFLOW_AUTHOR.
# EXPECTED_WORKFLOW_NAME=compliance-lifecycle-production

# Explicit opt-out for disposable local/testnet experiments only. Never use in production.
# ALLOW_UNPINNED_RECEIVER=false
