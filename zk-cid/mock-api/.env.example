# Port for the Express local dev server (default: 3001)
PORT=3001

# Token required in the x-admin-token header for POST /api/admin* endpoints.
# Default when unset: dev-token (LOCAL DEMO ONLY — change this in any shared deployment).
ADMIN_TOKEN=dev-token

# Comma-separated commitments pre-seeded into the sanctions list at startup.
# Example: SEED_SANCTIONED=12345678901234567890,98765432109876543210
SEED_SANCTIONED=
