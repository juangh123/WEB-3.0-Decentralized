# Port for the Express local dev server (default: 3001)
PORT=3001

# Token required in the x-admin-token header for POST /api/admin* endpoints.
# LOCAL DEV ONLY: when unset, the server falls back to "dev-token".
# In production (NODE_ENV=production or VERCEL_ENV=production) a non-default ADMIN_TOKEN is
# mandatory: admin requests are rejected (500) instead of silently accepting the default.
ADMIN_TOKEN=

# Comma-separated allow-list for browser CORS requests. Unset = permissive locally, same-origin
# only in production. Example: CORS_ORIGINS=https://web-3-0-decentralized.vercel.app
CORS_ORIGINS=

# Best-effort per-IP requests/minute limit for the admin endpoints (default: 30).
# In-memory only: it dampens abuse on one instance but is not a global serverless rate limit.
ADMIN_RATE_LIMIT=30

# Comma-separated commitments pre-seeded into the sanctions list at startup. Entries must be
# decimal field elements strictly below the BN254 scalar field; invalid values are dropped.
# Example: SEED_SANCTIONED=123456789012345678901234567890123456789
SEED_SANCTIONED=
