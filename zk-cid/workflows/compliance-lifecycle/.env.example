# Optional overrides for config.json. Set these in the CRE runtime
# (or your shell) so the same workflow source can run locally and on-chain.
SANCTIONS_API_URL=https://mock-api-topaz-zeta.vercel.app/api/sanctions-list
CHAIN_SELECTOR_NAME=ethereum-testnet-sepolia
COMPLIANCE_GATE_ADDRESS=0x1b8ae78C37c3E29DFcB0236E1c562b3CCFA44F70
# CRE 报告接收适配器(ComplianceGateReceiver);writeReport 的 receiver 参数
RECEIVER_ADDRESS=0xB5ad6413a16efd82b76212830f908B2D67C20425

# Chainlink CRE account credential, used by `cre workflow build|simulate`.
# Create it at https://app.chain.link -> Account Settings -> API Keys, or use
# the interactive `cre login` instead. Copy this file to `.env` and fill it in;
# `zk-cid/workflows/run-cre-simulate.ps1` loads that file automatically.
# Never commit the real value (`.env` is gitignored).
CRE_API_KEY=
